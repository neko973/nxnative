# Settings the 60 fps Mac build of Ocarina of Time was tuned and tested with (see docs/ocarina-of-time-mac-60fps.md).
# install-ocarina-mac.sh bakes this file into the app (--env-file), so a fresh build needs no setup.
# To change one for yourself without rebuilding, put KEY=VALUE lines in
#   ~/Library/Application Support/nxnative/0400486024DEC000/env.txt
# (create the folder and file if they are not there); a line there wins over the one here.

# Docked mode, presented at the display's own rate. (The game's upscaler is drawn by MetalFX by the game's profile, upscaler_mac; the settings window's
# Game's upscaler changes it, so it is not fixed here.)
DM_OPMODE=1
DM_PRESENT_INTERVAL=display
DM_NVN_DISPATCH_BARRIER=game

# Fullscreen at the screen's refresh rate (a window costs about 1.4 ms of GPU a frame)
DM_FULLSCREEN=1
DM_SCREEN_MATCH=0
DM_FOCUS_KEEP=1

# Frame rate "60" = 60 where the scene holds it, an even 40 where it does not, 30 last; the game keeps its real speed
DM_FPS_TICKS=1

# The frame-time work of this branch
DM_NVN_EVENT_GATE=1
DM_NVN_CUT=0
DM_NVN_CS_HOIST=0
DM_GPU_KEEP=hold
DM_PRESENT_LINK=0
DM_NVN_DEFER_LOAD=1

# Apple's performance HUD (frame rate and frame interval, top right): DM_METAL_HUD=1 turns it on
# The game's autosave calls nvnQueueFinish; waiting there for the last frame to reach the screen as well held the next frame (36-45 ms at every autosave).
DM_NVN_FINISH_PRESENT=0
